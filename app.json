{
  "expo": {
    "name": "Vile Chat",
    "slug": "vile-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Vile Chat to access your microphone to record voice notes.",
        "NSPhotoLibraryUsageDescription": "Allow Vile Chat to access your photos to send images."
      }
    },
    "android": {
      "package": "com.vilechat.app",
      "newArchEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FF3B69",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vile Chat to access your photos to send images."
        }
      ],
      "expo-audio"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
